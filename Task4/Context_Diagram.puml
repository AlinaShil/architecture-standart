@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма (MVP: передача актуальных ставок в КЦ банка)

Person(customer, "Клиент", "Звонит в кол-центр или получает СМС о статусах заявок")
Person(cc_operator, "Оператор кол-центра банка", "Консультирует клиентов по ставкам и продуктам")

System_Ext(telco, "Телеком-оператор", "", "Доставка СМС клиентам")

System_Boundary(bank_system, "Система банка «Стандарт»") {
    System(site, "Сайт", "PHP + React", "Витрина депозитов, форма заявки (новые клиенты)")
    System(ib, "Интернет-банк", "ASP.NET MVC 4.5 + MS SQL", "Подача заявок на депозиты для действующих клиентов")
    System(abs, "АБС", "Delphi + Oracle", "Учёт счетов, расчёт и хранение ставок, открытие депозитов")
    System(cc, "Система кол-центра банка", "React + Spring Boot + PostgreSQL", "Обработка звонков и заявок, доступ к ставкам из АБС")
    System(smsgw, "СМС-шлюз", "Внутренний сервис", "Отправка СМС клиентам")
}

' --- Взаимодействия клиентов ---
Rel(customer, cc_operator, "Звонок с вопросами о ставках/продуктах")
Rel(cc_operator, cc, "Работа с заявками и ставками")
Rel(telco, customer, "СМС о статусах заявок")

' --- Взаимодействия систем внутри банка ---
Rel(cc, abs, "Запрос актуальных ставок", "API/SQL")
Rel(site, cc, "Передача заявки", "HTTPS/TLS")
Rel(ib, abs, "Передача заявки на депозит", "API-шлюз/промежуточный сервис")
Rel(abs, smsgw, "Отправка СМС")
Rel(smsgw, telco, "Передача СМС клиенту")

@enduml
