@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Диаграмма компонентов (MVP: передача ставок в КЦ банка и СМС о статусах заявок)

' --- Акторы ---
Person(customer, "Клиент", "Получает консультации по телефону и СМС о статусах заявок")

' --- Контур АБС ---
Container_Boundary(abs_b, "АБС") {
    Component(abs_calc, "Модуль расчёта ставок", "PL/SQL", "Рассчитывает актуальные и персональные ставки")
    Component(abs_api, "API ставок", "PL/SQL + REST/SQL", "Предоставляет ставки системе кол-центра")
    Component(abs_deposits, "Модуль обработки депозитов", "PL/SQL", "Обработка заявок на депозиты, взаимодействие с СМС-шлюзом")
    ContainerDb(abs_db, "БД АБС", "Oracle", "Хранение данных по счетам, депозитам, ставкам")
}

' --- Контур системы кол-центра ---
Container(cc, "Система кол-центра банка", "Java + PostgreSQL") {
    Component(cc_ui, "UI операторов", "React.js", "Отображает ставки и заявки операторам")
    Component(cc_srv, "Сервис интеграции с АБС", "Java Spring Boot", "Запрашивает ставки через API и передаёт в UI")
    ContainerDb(cc_db, "БД КЦ", "PostgreSQL", "Хранение обращений и истории звонков")
}

' --- СМС-шлюз ---
Container(smsgw, "СМС-шлюз", "Внутренний сервис", "Отправка уведомлений клиентам о статусах заявок")

' --- Внешний телеком ---
System_Ext(telco, "Телеком-оператор", "", "Доставка СМС клиентам")

' --- Взаимодействия ---
Rel(customer, cc_ui, "Уточнение условий по телефону через оператора")
Rel(cc_ui, cc_srv, "Запрос ставок и информации по заявкам")
Rel(cc_srv, abs_api, "Получение актуальных ставок", "API/SQL")
Rel(abs_calc, abs_db, "Чтение/запись ставок")
Rel(abs_api, abs_calc, "Запрос расчёта ставок")
Rel(abs_deposits, abs_db, "Чтение/запись данных депозитов")
Rel(abs_deposits, smsgw, "Отправка СМС о статусах заявок")
Rel(smsgw, telco, "Передача СМС")
Rel(telco, customer, "Доставка СМС")

@enduml
